import React, { useState, useEffect } from "react";
import { CivicIssue } from "@/entities/all";
import { 
  AlertCircle, 
  CheckCircle2, 
  Clock, 
  Users,
  TrendingUp,
  MessageSquare,
  Phone,
  Smartphone
} from "lucide-react";

import StatsCard from "../components/dashboard/StatsCard";
import IssueMap from "../components/dashboard/IssueMap";
import IssueList from "../components/dashboard/IssueList";
import IssueDetails from "../components/issues/IssueDetails";

function MultiChannelSimulator() {
    const channels = [
        { name: "WhatsApp", icon: Smartphone, color: "text-green-500" },
        { name: "SMS", icon: MessageSquare, color: "text-blue-500" },
        { name: "IVR Call", icon: Phone, color: "text-purple-500" }
    ];
    const [activeChannel, setActiveChannel] = useState(0);

    useEffect(() => {
        const interval = setInterval(() => {
            setActiveChannel(prev => (prev + 1) % channels.length);
        }, 2000);
        return () => clearInterval(interval);
    }, [channels.length]); // Added channels.length to dependency array

    return (
        <div className="bg-card p-4 rounded-lg shadow-lg border border-border">
            <h3 className="font-semibold text-foreground mb-3 text-center">Multi-Channel Reporting</h3>
            <div className="relative h-16 flex items-center justify-center overflow-hidden">
                {channels.map((channel, index) => (
                    <div
                        key={channel.name}
                        className={`absolute transition-all duration-500 flex items-center gap-2 ${activeChannel === index ? 'opacity-100 translate-y-0' : 'opacity-0 -translate-y-5'}`}
                    >
                        <channel.icon className={`w-6 h-6 ${channel.color}`} />
                        <span className="font-medium text-foreground">{channel.name} Report Received</span>
                    </div>
                ))}
            </div>
        </div>
    );
}

export default function Dashboard() {
  const [issues, setIssues] = useState([]);
  const [selectedIssue, setSelectedIssue] = useState(null);
  const [selectedCategory, setSelectedCategory] = useState('all');
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    loadIssues();
  }, []);

  const loadIssues = async () => {
    setIsLoading(true);
    try {
      const fetchedIssues = await CivicIssue.list('-created_date');
      setIssues(fetchedIssues);
    } catch (error) {
      console.error('Error loading issues:', error);
    }
    setIsLoading(false);
  };

  const handleIssueSelect = (issue) => {
    setSelectedIssue(issue);
  };

  const handleIssueClose = () => {
    setSelectedIssue(null);
    loadIssues(); // Refresh data when closing details
  };

  // Calculate statistics
  const totalIssues = issues.length;
  const resolvedIssues = issues.filter(issue => issue.status === 'resolved' || issue.status === 'closed').length;
  const inProgressIssues = issues.filter(issue => issue.status === 'in_progress' || issue.status === 'assigned').length;
  const averageRating = issues.filter(issue => issue.citizen_rating).reduce((sum, issue) => sum + issue.citizen_rating, 0) / issues.filter(issue => issue.citizen_rating).length || 0;
  const resolutionRate = totalIssues > 0 ? Math.round((resolvedIssues / totalIssues) * 100) : 0;

  return (
    <div className="p-6 space-y-6 bg-background min-h-screen text-foreground">
      <div className="max-w-7xl mx-auto">
        {/* Header */}
        <div className="mb-8">
          <h1 className="text-3xl font-bold text-foreground mb-2">Civic Issues Dashboard</h1>
          <p className="text-muted-foreground">Real-time monitoring of community-reported issues</p>
        </div>

        {/* Stats Grid */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <StatsCard
            title="Total Issues"
            value={totalIssues}
            icon={AlertCircle}
            trend="this month"
            trendValue={12}
            bgGradient="bg-gradient-to-r from-blue-500 to-blue-600"
          />
          <StatsCard
            title="Resolved Issues"
            value={resolvedIssues}
            icon={CheckCircle2}
            trend="this month"
            trendValue={8}
            bgGradient="bg-gradient-to-r from-emerald-500 to-emerald-600"
          />
          <StatsCard
            title="In Progress"
            value={inProgressIssues}
            icon={Clock}
            bgGradient="bg-gradient-to-r from-orange-500 to-orange-600"
          />
          <StatsCard
            title="Resolution Rate"
            value={`${resolutionRate}%`}
            icon={TrendingUp}
            trend="vs last month"
            trendValue={5}
            bgGradient="bg-gradient-to-r from-purple-500 to-purple-600"
          />
        </div>

        {/* Main Content Grid */}
        <div className="grid lg:grid-cols-3 gap-6">
          {/* Map */}
          <div className="lg:col-span-2">
            <IssueMap 
              issues={issues}
              onIssueSelect={handleIssueSelect}
              selectedCategory={selectedCategory}
              onCategoryChange={setSelectedCategory}
            />
          </div>

          {/* Issue List & Simulator */}
          <div className="space-y-6">
            <IssueList 
              issues={issues}
              onIssueSelect={handleIssueSelect}
            />
            <MultiChannelSimulator />
          </div>
        </div>

        {/* Issue Details Modal */}
        {selectedIssue && (
          <IssueDetails 
            issue={selectedIssue}
            onClose={handleIssueClose}
          />
        )}
      </div>
    </div>
  );
}

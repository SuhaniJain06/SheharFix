{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "issue_id": {
      "type": "string",
      "description": "Related civic issue ID"
    },
    "work_order_number": {
      "type": "string",
      "description": "Unique work order identifier"
    },
    "assigned_department": {
      "type": "string",
      "description": "Department responsible for resolution"
    },
    "assigned_staff": {
      "type": "string",
      "description": "Staff member assigned"
    },
    "staff_contact": {
      "type": "string",
      "description": "Contact number of assigned staff"
    },
    "estimated_completion": {
      "type": "string",
      "format": "date",
      "description": "Expected completion date"
    },
    "actual_completion": {
      "type": "string",
      "format": "date",
      "description": "Actual completion date"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "accepted",
        "in_progress",
        "completed",
        "verified",
        "closed"
      ],
      "default": "created"
    },
    "progress_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Progress photos"
    },
    "completion_notes": {
      "type": "string",
      "description": "Notes from staff on completion"
    },
    "resources_used": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource_type": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "cost": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "issue_id",
    "assigned_department"
  ]
}